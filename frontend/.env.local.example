# Copy to frontend/.env.local for local development, or set these in the
# deployment environment at build time. All are optional; the app runs fine
# with none of them set (ads, analytics, and consent are all disabled).

# Base origin used for canonical URLs, Open Graph, sitemap, and structured data.
NEXT_PUBLIC_SITE_URL=https://genmyqrcode.com

# ---- Google AdSense (disabled by default) ----
# Set ENABLE_ADSENSE=true AND a publisher ID to activate ads.
NEXT_PUBLIC_ENABLE_ADSENSE=false
NEXT_PUBLIC_ADSENSE_PUBLISHER_ID=ca-pub-your-publisher-id
NEXT_PUBLIC_ADSENSE_SLOT_SEO_AFTER_TOOL=your-slot-id
NEXT_PUBLIC_ADSENSE_SLOT_SEO_SIDEBAR=your-slot-id
NEXT_PUBLIC_ADSENSE_SLOT_BLOG_INLINE=your-slot-id
NEXT_PUBLIC_ADSENSE_SLOT_BLOG_BOTTOM=your-slot-id

# ---- Google Analytics 4 (disabled by default) ----
NEXT_PUBLIC_ENABLE_ANALYTICS=false
NEXT_PUBLIC_GA_MEASUREMENT_ID=G-XXXXXXXXXX

# ---- Cookie consent + Consent Mode v2 (disabled by default) ----
# Enable to show a consent banner and deny ad/analytics storage until consent.
NEXT_PUBLIC_ENABLE_CONSENT=false
