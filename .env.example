POSTGRES_DB=qrmarketing
POSTGRES_USER=qrmarketing
POSTGRES_PASSWORD=change-me-in-development
POSTGRES_PORT=5432
BACKEND_PORT=8080
FRONTEND_PORT=3000

# Frontend — keep false until Phase 5 go-live (static product stays unchanged).
NEXT_PUBLIC_ENABLE_DYNAMIC_QR=false
# Local only: auto X-Dev-User-Id (never true in production).
NEXT_PUBLIC_DYNAMIC_QR_DEV_AUTH=false
NEXT_PUBLIC_API_BASE_URL=http://localhost:8080
# Same-origin proxy (recommended with Clerk — avoids CORS). Requires DYNAMIC_QR_API_ORIGIN.
# NEXT_PUBLIC_DYNAMIC_QR_USE_REWRITE=true
# DYNAMIC_QR_API_ORIGIN=https://qr-api-production-fb1c.up.railway.app

# Backend — master kill-switch (false = Dynamic API + redirect return 404).
DynamicQr__Enabled=false
DynamicQr__PublicBaseUrl=http://localhost:8080
# Legacy token create — local/dev only; set false on Railway production.
DynamicQr__AllowLegacyOwnerToken=false

# Local dev auth without Clerk (Development API only).
Auth__AllowDevUserHeader=false

# Clerk (Phase 5 production — required for real accounts).
# NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_...
# CLERK_SECRET_KEY=sk_test_...
# Auth__ClerkAuthority=https://YOUR-INSTANCE.clerk.accounts.dev
# Auth__ClerkAudience=

# Database migrations on API startup (Docker / Railway).
Database__MigrateOnStartup=true
